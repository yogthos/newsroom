;; Keys newsroom reads by name, kept here instead of in the environment.
;; The first start writes an empty secrets.edn in the config directory
;; (~/.config/newsroom, or $NEWSROOM_HOME); fill in the keys you use, as
;; below. Newsroom won't start while anyone but the owner can read the file,
;; so if you copy this one there instead, run chmod 600 on it. A variable
;; set in the environment wins over the same name here.
{"DEEPSEEK_API_KEY" "sk-..."
 "ZHIPU_API_KEY" "..."
 "OPENAI_API_KEY" "sk-..."
 "EXA_API_KEY" "..."
 ;; any name a provider's :api-key-env or a "${VAR}" in the settings uses
 "OPENROUTER_API_KEY" "sk-or-..."
 "SLACK_BOT_TOKEN" "xoxb-..."}
