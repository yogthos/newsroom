;; Every setting newsroom has, as EDN. Settings are edited on the config page
;; at /config and kept in the database, but any key here other than :host,
;; :port and :db is moved into the database when newsroom starts, so this
;; file can be dropped in as ~/.config/newsroom/config.edn to start from it.
;; Keys you leave out keep the settings they have.
{;; The interface the page is served on, as an IPv4 address. The default is
 ;; loopback, so only this machine can reach it; "0.0.0.0" listens on every
 ;; interface. There's no login, so anyone who can reach the port can read the
 ;; briefings and start or cancel a run.
 :host "127.0.0.1"
 :port 3000

 ;; When the briefing is gathered, local time, and how many hours apart after
 ;; that. A wake re-gathers the day only when its briefing is at least that
 ;; old, so 24 gives one a day and 6 refreshes it through the day. nil for
 ;; :run-at turns the schedule off and leaves only the refresh button.
 :run-at "07:00"
 :run-every-hours 24

 ;; Days of briefings to keep. Older days are deleted with their sources and
 ;; markdown files after each new briefing. -1 keeps everything. What the
 ;; digests need, each source's coverage, the story notes and the days'
 ;; standfirsts, is kept four months longer, so a month's digest can always
 ;; be compared with the four months before it.
 :keep-days 100

 ;; How far back an item's date may be, in days before the briefing's day.
 ;; Undated items are always kept.
 :lookback-days 1

 ;; The most items taken from one outlet in a source, and in all. A source
 ;; that reads many outlets, like a feed reader or a search crediting its
 ;; results to outlets, gives each its own share. The overall cap keeps the
 ;; most widely carried stories (see :story-threshold), and among equals
 ;; outlets are taken in turn, so it trims every one evenly.
 :max-items-per-source 12
 :max-items 180

 ;; How many past briefings a story is remembered from. A story told in any
 ;; of the last :seen-days briefings is left out of today's, so one dropped
 ;; for space yesterday is not retold today.
 :seen-days 3

 ;; Stories from different outlets whose titles and summaries embed this
 ;; close (cosine similarity) are collapsed into one source, with the other
 ;; outlets noted on it as "also reported by". An outlet is a publisher, by
 ;; its web domain, so a publisher's several feeds count once and only
 ;; collapse into each other when near verbatim; a story whose dateline
 ;; names a wire agency, as in "WASHINGTON (AP) —", counts as the agency's.
 ;; Same-story pairs from a day of the default feeds mostly score 0.6 to
 ;; 0.8, and different stories on one topic mostly below 0.6. nil turns
 ;; collapsing off.
 :dupe-threshold 0.62

 ;; A story is followed from day to day: an item whose embedding is this
 ;; close to the sources of a story from the last :trend-days continues it.
 ;; Items are ranked by how widely and how long their story has run, the
 ;; outlets carrying it today plus the outlets on each earlier day, an
 ;; earlier day counting half as much every :half-life-days. The heaviest
 ;; come first in the prompt, with their coverage noted, and survive
 ;; :max-items. nil stops the following, and the ranking is by today's
 ;; outlets alone.
 :story-threshold 0.6
 :trend-days 7
 :half-life-days 2

 ;; After each briefing the model keeps a running note on every storyline
 ;; the briefing cited, and keeps the notes it already has up to date; a
 ;; story the briefing passed over starts none. A note is a stable title, a
 ;; summary of where the story stands, and up to this many dated facts, each
 ;; tied to the report it came from. Each day's reports are compacted into
 ;; the note, so repeats merge and superseded details drop out. The briefing
 ;; gets the notes of the stories still running as background, and the
 ;; digests cite the notes' facts. It costs one more model call a day; a
 ;; :notes role in :roles can point it at a cheaper model. nil turns the
 ;; notes off.
 :story-notes 12

 ;; Before the briefing is written, a researcher searches the web for
 ;; earlier events like the day's stories, in rounds, reading each round's
 ;; results before the next, and picks the ones that show how today's may
 ;; develop. They join the day's sources as precedents, for the analyst to
 ;; ground its projections in and cite. At most this many searches; nil
 ;; turns the research off.
 :precedent-searches 12

 ;; The desk's work before the briefing. The model sorts the day's reports
 ;; into stories, the reports on one event from different sides together,
 ;; each with an importance and a status, and leaves out what isn't news.
 ;; It reads the main reports of the top :dossier-stories stories in full,
 ;; :read-articles of each, one an outlet, and writes a dossier on each from
 ;; them alone: the salient facts with citations, the actors' positions and
 ;; interests, disputed accounts, framing, what's missing, the forces at
 ;; work. Then it maps the trends running through the day, following each
 ;; from the days before, and the links between the stories, which the
 ;; briefing's graph is drawn from, and runs up to :gap-searches searches
 ;; for what the reports left out. nil :dossier-stories turns the
 ;; dossiers, the map and the gap searches off.
 :group-stories true
 :dossier-stories 20
 :read-articles 3
 :connect-stories true
 :gap-searches 6

 ;; Digests written from the stored days: a week's once the week is over
 ;; (weeks run Monday to Sunday), a month's once the month is. Each ranks
 ;; the storylines of the period by their coverage and says which are
 ;; emerging, persistent or fading against the four periods before it, then
 ;; the model writes it from the storylines' notes and each day's
 ;; standfirst. the digest prompt is theirs, and :digest-stories how many
 ;; storylines it is given. [] turns them off.
 :digests [:week :month]
 :digest-stories 15

 ;; The track record. Each briefing's and digest's projections are
 ;; recorded, and so are the expectations the outlets put forward in the
 ;; reports the dossiers read, credited to the outlet. After each digest
 ;; the ones fallen due are checked against what happened: held, partly or
 ;; failed, how close they came and why. Lessons are kept from the
 ;; verdicts, and every outlet is ranked within each subject, so one that
 ;; reads technology well can still be ranked low on geopolitics. The
 ;; briefings and digests are told the lessons and the records, and
 ;; /record shows them. A :retrospective role can give the job its own
 ;; model. false turns it off.
 :retrospective true

 ;; How long one source may take before the run goes on without it.
 :source-timeout-ms 30000

 ;; Where the sqlite database lives, if not in the config directory.
 ;; :db "/var/lib/newsroom/newsroom.sqlite3"

 :sources
 [;; --- RSS and Atom --------------------------------------------------------
  ;; Any RSS 2.0, RSS 1.0 (RDF) or Atom feed.
  {:type :rss :name "BBC World" :url "https://feeds.bbci.co.uk/news/world/rss.xml"}
  {:type :rss :name "CGTN Business" :url "https://www.cgtn.com/subscribe/rss/section/business.xml"}
  ;; some servers refuse clients they don't recognize; any source can send
  ;; its own User-Agent
  {:type :rss :name "Wired" :url "https://www.wired.com/feed/rss"
   :user-agent "Mozilla/5.0 (compatible; newsroom)"}

  ;; --- scraping a page ------------------------------------------------------
  ;; For a site with no feed. The page at :url is read, and every link on it
  ;; whose full URL matches :link-pattern (a Java-style regex, so backslashes
  ;; are doubled in EDN) becomes a story, titled by its link text. Links
  ;; that aren't stories, like section fronts and navigation, just need a
  ;; pattern that leaves them out. Relative links are resolved against the
  ;; page first.
  {:type :scrape :name "Xinhua" :url "https://english.news.cn/world/index.htm"
   :link-pattern "news\\.cn/(\\w+/)?\\d{8}/[0-9a-f]{32}/c\\.html"
   ;; the most stories taken from the page, default 15
   :limit 15}

  ;; With :summaries true, each story's own page is read too, for the
  ;; description and publication date in its meta tags. That's one request
  ;; per story, so keep :limit small.
  {:type :scrape :name "CGTN Sci-Tech" :url "https://www.cgtn.com/sci-tech"
   :link-pattern "cgtn\\.com/news/\\d{4}-\\d{2}-\\d{2}/"
   :limit 8
   :summaries true}

  ;; --- web search -----------------------------------------------------------
  ;; Searches through Exa. No key is needed, and EXA_API_KEY raises the rate
  ;; limit. {{date}} in a query is the briefing's day written out, like
  ;; "30 September 2026".
  {:type :web-search :name "Web search"
   ;; results per query, at most 10
   :results 6
   :queries ["top world news {{date}}"
             "global economy markets news {{date}}"
             ;; site: keeps a search to one outlet, and :name credits its
             ;; results to that outlet instead of to the search
             {:name "CCTV" :query "site:english.cctv.com news {{date}}"}]}

  ;; --- a plugin -------------------------------------------------------------
  ;; A source type of your own, from a plugin in plugins/. The whole map is
  ;; handed to the plugin, so it can take any keys it likes. These two are
  ;; in plugins/ in the repo, and are used by copying their folders to
  ;; plugins/ in the config directory.
  ;; {:type :slack :name "Slack #news" :channel "C0123456789"}
  ;; reddit reads about one feed a minute, so its subreddits share a source
  ;; {:type :reddit :subreddit ["technology" "worldnews"] :limit 10}
  ]

 ;; --- plugin settings ------------------------------------------------------
 ;; Each plugin's settings, under the name of its folder in plugins/. A
 ;; string written as "${VAR}" is read from the environment.
 :plugins
 {:slack {:token "${SLACK_BOT_TOKEN}"
          :workspace "acme"}}

 ;; --- models ---------------------------------------------------------------
 ;; Endpoints are declared under :providers by alias. An alias named after a
 ;; built-in (:deepseek, :glm, :openai, :local, :ollama) takes that provider's
 ;; defaults and only overrides what it sets; any other alias needs a :type
 ;; saying which built-in it works like.
 ;;
 ;; A key comes from :api-key-env, the name of an environment variable, or
 ;; from :api-key, either written out or as "${VAR}". Each built-in already
 ;; knows its usual variable: DEEPSEEK_API_KEY, ZHIPU_API_KEY, OPENAI_API_KEY.
 :providers
 {;; DeepSeek, with a bigger model than the default flash one
  :deepseek {:model "deepseek-v4-pro"}

  ;; Zhipu's GLM through the coding plan endpoint
  :glm {:model "glm-5.3"}

  ;; OpenAI
  :openai {:model "gpt-4o"}

  ;; any OpenAI-compatible service, here OpenRouter
  :openrouter {:type :openai
               :base-url "https://openrouter.ai/api/v1"
               :api-key-env "OPENROUTER_API_KEY"
               :model "qwen/qwen3-235b-a22b"
               ;; extra headers some gateways want
               :headers {"HTTP-Referer" "https://github.com/yogthos/newsroom"}}

  ;; a local llama.cpp server, vLLM or LM Studio
  :llama {:type :local
          :base-url "http://127.0.0.1:8080/v1"
          :model "local-model"
          ;; let a reasoning model think; off by default for local servers
          :thinking? true
          ;; local models are slow, so give them longer
          :timeout-ms 1800000}

  ;; Ollama's own API
  :ollama {:model "qwen3"}}

 ;; Every provider also takes these, shown here with their defaults:
 ;;   :max-tokens 32768     the reply's budget; a thinking model spends part
 ;;                         of it on reasoning before it writes anything
 ;;   :temperature 0.4
 ;;   :timeout-ms 600000    how long a read may wait on the model
 ;;   :reasoning-effort     "low", "high" and so on, where the model has it

 ;; Which provider does each job. :analyst writes the briefing and the
 ;; digests. :notes keeps the story notes, the analyst when it's left out;
 ;; it's routine extraction, so a cheaper or faster model does well here.
 ;; :research looks for the precedents, the analyst when it's left out.
 ;; :desk sorts the day's reports into stories, writes the dossiers and
 ;; maps the trends and links between them, the analyst when it's left out.
 :roles {:analyst :deepseek
         ;; :notes :glm
         ;; :research :glm
         ;; :desk :glm
         ;; :retrospective :glm
         }}
