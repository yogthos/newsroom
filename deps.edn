{:jolt/min-version "0.8.16"

 :paths ["src" "resources"]

 :deps {;; HTTP server: HTTP/1.1 over jolt.socket.native (jolt 0.8.16+). Past
        ;; v0.7.11 for the Windows sockets, which no tag carries yet
        jolt-lang/ring-chez-adapter
        {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
         :git/sha "36ac49d21c30a91d37f2104b31b9fc29e6991b27"}

        ;; outbound HTTP: feeds, web search, the LLM
        jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/tag "v0.1.0"
         :git/sha "d99af98cc97dcb2e4afc3eee142166585a26b859"}

        ;; java.time shim; data.json and date handling need it
        jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time"
         :git/tag "v0.0.10"
         :git/sha "faff43aa3260bf79bb3fba10f6d9336190f83281"}

        ;; sqlite through the system libsqlite3
        jolt-lang/db
        {:git/url "https://github.com/jolt-lang/db"
         :git/tag "v0.4.1"
         :git/sha "067f95e23ea8e1117052762e97d63436d2c6c259"}

        ;; clojure.xml over libxml2, for RSS and Atom
        jolt-lang/xml
        {:git/url "https://github.com/jolt-lang/xml"
         :git/tag "v0.0.4"
         :git/sha "688914b2805a9f1316d4c83572959f7631b9cbfd"}

        ;; datastar wire protocol, SSE re-render on ratom change
        jolt-lang/glimmer-datastar
        {:git/url "https://github.com/jolt-lang/glimmer-datastar"
         :git/tag "v0.1.2"
         :git/sha "63126adaa17931707f0077913702d87d7becfb6e"}

        ;; the ratoms behind the live page; from v0.1.4 swap! is atomic, which
        ;; the run status needs since sources report from several threads
        jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer"
         :git/tag "v0.1.4"
         :git/sha "09b8ab08705fa1e6f20145c2e99eaaba9ea812cc"}

        ;; missionary for jolt: concurrent, cancellable ingestion
        jlt-commons/ebb
        {:git/url "https://github.com/jlt-commons/ebb"
         :git/tag "v0.1.3"
         :git/sha "5f6a4f3adcfcb8cace4cbb691c7be6cb0d15724b"}

;; schemas: an imported config is checked against them
        metosin/malli
        {:git/url "https://github.com/metosin/malli"
         :git/tag "0.20.1"
         :git/sha "13656199432c9fc44747212a0114f3c7c9a9fb4b"}

;; the prompt templates. selmer.validator reads its
        ;; selmer-error-template.html when it loads, and a built binary embeds
        ;; only this project's resources (jolt-lang/jolt#1232), so a copy is in
        ;; resources/
        selmer/selmer
        {:git/url "https://github.com/yogthos/Selmer"
         :git/tag "v1.13.5"
         :git/sha "932c7bddc818ed0514bb8f24376e9b892a5a1554"}

;; the Ring middleware: params, resources, content types
        ring/ring-core {:mvn/version "1.15.4"}
        ring/ring-codec {:mvn/version "1.3.0"}

        ;; routing
        askonomm/ruuter
        {:git/url "https://git.nmm.ee/asko/ruuter.git"
         :git/tag "v2.1.1"
         :git/sha "263f868cf19e73ccda7cda6b4d4af1d8fe504749"}

        org.clojure/data.json
        {:git/url "https://github.com/clojure/data.json"
         :git/sha "94463ffb54482427fd9b31f264b06bff6dcfd557"}

        weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}}

 :jolt/build {:embed ["resources"]}

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {jlt-commons/writ
                               {:git/url "https://github.com/jlt-commons/writ"
                                :git/tag "v0.1.2"
                                :git/sha "57d863b290e7abe9f2918f969c2a6c74ee6d5a21"}}
                  :main-opts ["-m" "newsroom.test-runner"]}}

 :tasks {serve {:doc "run the newsroom server" :main-opts ["-m" "newsroom.core"]}
         test  "jolt -M:test"}}
