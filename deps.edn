{:jolt/min-version "0.8.16"

 :paths ["src" "resources"]

 :deps {;; outbound HTTP: feeds, web search, the LLM
        jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/tag "v0.1.3"
         :git/sha "7ea9bbd3b176b4567b4c94d7177d67c5f06109f7"}

        ;; sqlite through the system libsqlite3
        jolt-lang/db
        {:git/url "https://github.com/jolt-lang/db"
         :git/tag "v0.4.1"
         :git/sha "067f95e23ea8e1117052762e97d63436d2c6c259"}

        ;; clojure.xml over libxml2, for RSS and Atom
        jolt-lang/xml
        {:git/url "https://github.com/jolt-lang/xml"
         :git/tag "v0.0.4"
         :git/sha "688914b2805a9f1316d4c83572959f7631b9cbfd"}

        ;; datastar wire protocol, SSE re-render on ratom change
        jolt-lang/glimmer-datastar
        {:git/url "https://github.com/jolt-lang/glimmer-datastar"
         :git/tag "v0.1.6"
         :git/sha "975c4018d93bafb6f7b7fa399768f657ddfe7f1a"}

        ;; the ratoms behind the live page; from v0.1.4 swap! is atomic, which
        ;; the run status needs since sources report from several threads
        jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer"
         :git/tag "v0.1.6"
         :git/sha "d81af8fb2fa4164a2261db3c15fc7c93271dce60"}

        ;; missionary for jolt: concurrent, cancellable ingestion
        jlt-commons/ebb
        {:git/url "https://github.com/jlt-commons/ebb"
         :git/tag "v0.1.4"
         :git/sha "15f6f7c0ee8b54a862e9f981b5867fab23459498"}

        ;; TinyDecide through lev's encoders, to screen the reports before the
        ;; desk sorts them; its kernels are built by `jolt lev`. lev also
        ;; brings the HTTP server (jolt-lang/ring-chez-adapter, HTTP/1.1 over
        ;; jolt.socket.native), the java.time shim data.json and date
        ;; handling need (jolt-lang/time) and the router (askonomm/ruuter)
        jlt-commons/lev
        {:git/url "https://github.com/jlt-commons/lev"
         :git/tag "v0.3.3"
         :git/sha "50cb3647af80ebe529e416d9327d722301716515"}

;; schemas: an imported config is checked against them
        metosin/malli
        {:git/url "https://github.com/metosin/malli"
         :git/tag "0.20.3"
         :git/sha "91d3c1bb81288d5b2e3d260fd9847da3b74c631c"}

;; the prompt templates. selmer.validator reads its
        ;; selmer-error-template.html when it loads, and a built binary embeds
        ;; only this project's resources (jolt-lang/jolt#1232), so a copy is in
        ;; resources/
        selmer/selmer
        {:git/url "https://github.com/yogthos/Selmer"
         :git/tag "v1.13.5"
         :git/sha "932c7bddc818ed0514bb8f24376e9b892a5a1554"}

;; the Ring middleware: params, resources, content types
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-codec {:mvn/version "1.3.0"}

        org.clojure/data.json
        {:git/url "https://github.com/clojure/data.json"
         :git/sha "94463ffb54482427fd9b31f264b06bff6dcfd557"}}

 :jolt/build {:embed ["resources"]}

 ;; the speech engine behind newsroom.tts: llama.cpp, the S3 decoder on ggml
 ;; and LAME, built by `jolt tts` into native/. Optional at runtime: without
 ;; it there are no podcasts. `jolt build` links the archive in, with the C++
 ;; runtime and, on macOS, the Metal frameworks it needs. A GPU plugin for
 ;; CUDA, HIP or Vulkan is loaded by newsroom.tts itself, when it's there
 :jolt/native [{:name "newsroom_tts"
                :optional true
                :darwin ["native/libnewsroom_tts.dylib"]
                :linux ["native/libnewsroom_tts.so"]
                ;; by platform, so Windows, which has no engine, links none
                :static {:darwin {:archive "native/libnewsroom_tts.a"}
                         :linux {:archive "native/libnewsroom_tts.a"}}}
               {:name "cxx"
                :optional true
                :darwin ["libc++.1.dylib"]
                :linux ["libstdc++.so.6"]
                :static {:darwin {:lib "c++"} :linux {:lib "stdc++"}}}
               ;; Metal, on macOS: the frameworks are linked by their stubs,
               ;; which native/build_tts.sh links into native/frameworks
               {:name "metal"
                :optional true
                :darwin ["/System/Library/Frameworks/Metal.framework/Metal"]
                :linux []
                :static {:darwin {:lib "Metal" :libdir "native/frameworks"}}}
               {:name "foundation"
                :optional true
                :darwin ["/System/Library/Frameworks/Foundation.framework/Foundation"]
                :linux []
                :static {:darwin {:lib "Foundation" :libdir "native/frameworks"}}}
               {:name "metalkit"
                :optional true
                :darwin ["/System/Library/Frameworks/MetalKit.framework/MetalKit"]
                :linux []
                :static {:darwin {:lib "MetalKit" :libdir "native/frameworks"}}}]

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {jlt-commons/writ
                               {:git/url "https://github.com/jlt-commons/writ"
                                :git/tag "v0.1.10"
                                :git/sha "4055b495575e5ddd806b155e25a6678b31153761"}}
                  :main-opts ["-m" "newsroom.test-runner"]}}

 :tasks {:requires ([babashka.fs :as fs] [clojure.string :as str])

         serve {:doc "run the newsroom server" :main-opts ["-m" "newsroom.core"]}
         test  "jolt -M:test"

         tts
         {:doc "fetch llama.cpp at the pinned commit into native/llama.cpp and build the speech engine around it, native/build_tts.sh: the engine newsroom links, on the CPU and on macOS on Metal, and with NEWSROOM_TTS_GPU=cuda|hip|vulkan a GPU plugin beside it (LLAMA_CPP_SRC=path fetches from a local checkout holding that commit)"
          :task (let [rev "0bb496dbd3af0add77ff82c406a915b41e839d56" ; b11400
                      src (or (System/getenv "LLAMA_CPP_SRC") "https://github.com/ggml-org/llama.cpp")
                      dir "native/llama.cpp"
                      head (str dir "/.git/HEAD")]
                  (when-not (and (fs/exists? head) (= rev (.trim (slurp head))))
                    (fs/delete-tree dir)
                    (fs/create-dirs dir)
                    (shell "git" "-C" dir "init" "--quiet")
                    (shell "git" "-C" dir "fetch" "--quiet" "--depth" "1" src rev)
                    (shell "git" "-C" dir "checkout" "--quiet" "FETCH_HEAD"))
                  (shell "sh" "native/build_tts.sh"))}

         lev
         {:doc "build lev's kernels in its checkout, the gitlib `jolt path` names, which jolt doesn't build for a dependency: the screening model (newsroom.screen) runs on them, and `jolt build` links their archive. Not on Windows, which has no BLAS for them"
          :task (let [root (->> (str/split (:out (shell {:out :string} "jolt" "path")) #":")
                                (map str/trim)
                                (filter #(str/includes? % "jlt-commons_lev"))
                                first)]
                  (when-not root
                    (throw (ex-info "lev isn't among the resolved deps (jolt path)" {})))
                  (shell {:dir (str (fs/parent root))} "jolt" "kernels"))}

         tts-test
         {:doc "check the speech engine against test/golden/tts: the decoder stage by stage, then the prompt, the speech model's first logits and a spoken line, written to native/build/golden.mp3. Needs `jolt tts` and the model's converted files, in NEWSROOM_TTS_DIR or ~/.config/newsroom/tts, which the first podcast fetches"
          :depends [tts]
          :task (let [dir (or (System/getenv "NEWSROOM_TTS_DIR")
                              (str (or (System/getenv "NEWSROOM_HOME")
                                       (str (System/getProperty "user.home") "/.config/newsroom"))
                                   "/tts"))]
                  (when-not (fs/exists? (str dir "/s3gen.gguf"))
                    (throw (ex-info (str "no converted model files in " dir) {})))
                  (shell "native/build/test-s3gen" (str dir "/s3gen.gguf") "test/golden/tts")
                  (shell "native/build/test-tts" (str dir "/model-q4_0.gguf") (str dir "/s3gen.gguf")
                         (str dir "/voices.gguf") "test/golden/tts" "native/build/golden.mp3"))}

         mini-test
         {:doc "check the small engine, KittenTTS mini, against test/golden/mini: the phonemes and token ids each sentence gets and the durations the model gives them, the first sentence's audio written to native/build/mini.raw. Needs `jolt tts` and the model's files in NEWSROOM_TTS_DIR/mini or ~/.config/newsroom/tts/mini, which its first podcast fetches"
          :depends [tts]
          :task (let [dir (str (or (System/getenv "NEWSROOM_TTS_DIR")
                                   (str (or (System/getenv "NEWSROOM_HOME")
                                            (str (System/getProperty "user.home") "/.config/newsroom"))
                                        "/tts"))
                               "/mini")]
                  (when-not (fs/exists? (str dir "/kitten_tts_mini_v0_8.onnx"))
                    (throw (ex-info (str "no model files in " dir) {})))
                  (shell "native/build/test-mini" (str dir "/kitten_tts_mini_v0_8.onnx") (str dir "/voices.npz")
                         (str dir "/config.json") "native/espeak-ng-data" "test/golden/mini" "native/build/mini.raw"))}

         mini-golden
         {:doc "regenerate test/golden/mini from the upstream kittenml package (dev/mini_golden.py through uv), with ESPEAK_LIBRARY and ESPEAK_DATA_PATH naming an espeak-ng 1.52.0 when the wheel's can't find its data, as on macOS"
          :task (shell "uv" "run" "--no-project" "--python" "3.12"
                       "--with" "kittenml==0.9.4" "--with" "onnxruntime==1.31.0" "--with" "phonemizer==3.4.0"
                       "python" "dev/mini_golden.py" "test/golden/mini")}

         tts-golden
         {:doc "regenerate test/golden/tts from the upstream kittenml package (dev/tts_golden.py through uv)"
          :task (shell "uv" "run" "--no-project" "--python" "3.12"
                       "--with" "kittenml==0.9.4" "--with" "torch==2.14.1" "--with" "torchaudio==2.11.0"
                       "--with" "transformers==5.19.0" "--with" "numpy==2.5.3" "--with" "safetensors==0.8.0"
                       "--with" "soundfile==0.14.0"
                       "python" "dev/tts_golden.py" "test/golden/tts")}}}
